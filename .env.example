# The dashboard lives here; each app gets <name>.<this domain>.
NEPHOS_DOMAIN=nephos.example.com
ACME_EMAIL=you@example.com

# Sign-in emails. Any SMTP provider works (Resend, Postmark, SES, Mailgun).
# Port 587 uses STARTTLS, port 465 uses TLS. Leave NEPHOS_SMTP empty to print emails to the log.
NEPHOS_SMTP=smtp.resend.com:587
NEPHOS_SMTP_USER=resend
NEPHOS_SMTP_PASS=
NEPHOS_MAIL_FROM="nephos <hello@example.com>"

# Anyone with an address at these domains can open apps you set to "org" (comma separated).
NEPHOS_ORG_DOMAINS=rvu.edu.in
